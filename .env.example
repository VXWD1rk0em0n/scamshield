# Copy to .env and fill in. Never commit .env.
# Without a key ScamShield runs in rules-only (offline) mode.
ANTHROPIC_API_KEY=
# Classifier model (default: claude-opus-5)
SCAMSHIELD_LLM_MODEL=claude-opus-5
# Server-side refusal fallbacks: auto (on for claude-opus-5 / claude-fable-5-1) | default | off
SCAMSHIELD_LLM_FALLBACKS=auto
# Secret used to hash sender/user IDs in the audit DB. If unset, a random one is generated in data/.pepper
SCAMSHIELD_PEPPER=
# Optional overrides
# SCAMSHIELD_CONFIG=config/scamshield.toml
# SCAMSHIELD_DB=data/scamshield.db
